# Copy to .env ONLY in a local checkout wired to the new Stage workspace.
# .env is git-ignored. `aio app use <workspace>.json` adds the AIO_* runtime
# credentials to .env itself — never commit them.

# Web actions: caller client ids allowed to submit / poll (comma-separated).
# Empty = run-workflow-service only (Workflow Builder). Add your own
# integration's client id temporarily for manual tests against Stage.
ALLOWED_CALLER_CLIENT_IDS=
